-- ModuleScript: ReplicatedStorage > WindUI
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local T = {
	bg = Color3.fromRGB(10, 10, 12),
	panel = Color3.fromRGB(20, 20, 24),
	item = Color3.fromRGB(32, 32, 38),
	line = Color3.fromRGB(70, 70, 80),
	text = Color3.fromRGB(235, 235, 240),
	muted = Color3.fromRGB(130, 130, 140),
	accent = Color3.fromRGB(245, 245, 250),
}

local Lib = {}

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = o
end

local function stroke(o, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col or T.line
	s.Thickness = th or 1
	s.Transparency = tr or 0
	s.Parent = o
	return s
end

local function label(parent, text, size, font, col)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextSize = size or 12
	l.Font = font or Enum.Font.Gotham
	l.TextColor3 = col or T.text
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

function Lib:CreateWindow(title)
	local sg = Instance.new("ScreenGui")
	sg.Name = "WindUI"
	sg.ResetOnSpawn = false
	sg.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local main = Instance.new("Frame")
	main.Size = UDim2.fromOffset(460, 320)
	main.Position = UDim2.new(0.5, -230, 0.5, -160)
	main.BackgroundColor3 = T.bg
	main.Active = true
	main.Draggable = true
	main.Parent = sg
	corner(main, 12)
	stroke(main, T.accent, 1.5, 0.6) -- glow tipis putih

	local head = label(main, title or "WindUI", 15, Enum.Font.GothamBold)
	head.Size = UDim2.new(1, -60, 0, 36)
	head.Position = UDim2.fromOffset(14, 0)

	local x = Instance.new("TextButton")
	x.Size = UDim2.fromOffset(26, 22)
	x.Position = UDim2.new(1, -34, 0, 7)
	x.BackgroundColor3 = T.item
	x.Text = "X"
	x.TextColor3 = T.text
	x.Font = Enum.Font.GothamBold
	x.TextSize = 12
	x.Parent = main
	corner(x, 6)
	x.MouseButton1Click:Connect(function() sg:Destroy() end)

	local sep = Instance.new("Frame")
	sep.Size = UDim2.new(1, -20, 0, 1)
	sep.Position = UDim2.fromOffset(10, 36)
	sep.BackgroundColor3 = T.line
	sep.BorderSizePixel = 0
	sep.Parent = main

	local tabBar = Instance.new("Frame")
	tabBar.Size = UDim2.new(0, 110, 1, -50)
	tabBar.Position = UDim2.fromOffset(10, 44)
	tabBar.BackgroundTransparency = 1
	tabBar.Parent = main
	local tl = Instance.new("UIListLayout")
	tl.Padding = UDim.new(0, 4)
	tl.Parent = tabBar

	local pages = Instance.new("Frame")
	pages.Size = UDim2.new(1, -138, 1, -54)
	pages.Position = UDim2.fromOffset(128, 44)
	pages.BackgroundColor3 = T.panel
	pages.Parent = main
	corner(pages, 10)

	local Window = {}
	local allPages, allBtns = {}, {}

	function Window:Tab(name)
		local page = Instance.new("ScrollingFrame")
		page.Size = UDim2.new(1, -12, 1, -12)
		page.Position = UDim2.fromOffset(6, 6)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = 3
		page.ScrollBarImageColor3 = T.muted
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.CanvasSize = UDim2.new()
		page.Visible = #allPages == 0
		page.Parent = pages
		local pl = Instance.new("UIListLayout")
		pl.Padding = UDim.new(0, 6)
		pl.Parent = page
		table.insert(allPages, page)

		local tb = Instance.new("TextButton")
		tb.Size = UDim2.new(1, 0, 0, 30)
		tb.Text = name
		tb.Font = Enum.Font.GothamBold
		tb.TextSize = 12
		tb.Parent = tabBar
		corner(tb, 8)
		table.insert(allBtns, tb)

		local function select()
			for i, p in ipairs(allPages) do
				p.Visible = (p == page)
				local on = (p == page)
				allBtns[i].BackgroundColor3 = on and T.accent or T.item
				allBtns[i].TextColor3 = on and T.bg or T.muted
			end
		end
		tb.MouseButton1Click:Connect(select)
		if page.Visible then select() else
			tb.BackgroundColor3 = T.item
			tb.TextColor3 = T.muted
		end

		local Tab = {}

		function Tab:Label(text)
			local l = label(page, text, 12, Enum.Font.Gotham, T.muted)
			l.Size = UDim2.new(1, -6, 0, 20)
		end

		function Tab:Button(text, cb)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, -6, 0, 32)
			b.BackgroundColor3 = T.item
			b.Text = text
			b.TextColor3 = T.text
			b.Font = Enum.Font.GothamBold
			b.TextSize = 12
			b.Parent = page
			corner(b, 8)
			stroke(b, T.line, 1)
			b.MouseButton1Click:Connect(function()
				if cb then cb() end
			end)
		end

		function Tab:Toggle(text, default, cb)
			local state = default and true or false
			local f = Instance.new("TextButton")
			f.Size = UDim2.new(1, -6, 0, 32)
			f.BackgroundColor3 = T.item
			f.Text = ""
			f.Parent = page
			corner(f, 8)
			stroke(f, T.line, 1)
			local l = label(f, text, 12, Enum.Font.GothamBold)
			l.Size = UDim2.new(1, -60, 1, 0)
			l.Position = UDim2.fromOffset(10, 0)
			local track = Instance.new("Frame")
			track.Size = UDim2.fromOffset(36, 18)
			track.Position = UDim2.new(1, -46, 0.5, -9)
			track.Parent = f
			corner(track, 9)
			local knob = Instance.new("Frame")
			knob.Size = UDim2.fromOffset(14, 14)
			knob.Parent = track
			corner(knob, 7)
			local function refresh()
				track.BackgroundColor3 = state and T.accent or T.line
				knob.BackgroundColor3 = state and T.bg or T.text
				knob.Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
			end
			refresh()
			f.MouseButton1Click:Connect(function()
				state = not state
				refresh()
				if cb then cb(state) end
			end)
		end

		function Tab:Slider(text, min, max, default, cb)
			local value = default or min
			local f = Instance.new("Frame")
			f.Size = UDim2.new(1, -6, 0, 44)
			f.BackgroundColor3 = T.item
			f.Parent = page
			corner(f, 8)
			stroke(f, T.line, 1)
			local l = label(f, text, 12, Enum.Font.GothamBold)
			l.Size = UDim2.new(1, -60, 0, 22)
			l.Position = UDim2.fromOffset(10, 2)
			local v = label(f, tostring(value), 12, Enum.Font.Code, T.muted)
			v.Size = UDim2.fromOffset(44, 22)
			v.Position = UDim2.new(1, -54, 0, 2)
			v.TextXAlignment = Enum.TextXAlignment.Right
			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, -20, 0, 6)
			bar.Position = UDim2.fromOffset(10, 30)
			bar.BackgroundColor3 = T.line
			bar.BorderSizePixel = 0
			bar.Parent = f
			corner(bar, 3)
			local fill = Instance.new("Frame")
			fill.BackgroundColor3 = T.accent
			fill.BorderSizePixel = 0
			fill.Parent = bar
			corner(fill, 3)
			local function set(n)
				value = math.clamp(math.floor(n + 0.5), min, max)
				fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
				v.Text = tostring(value)
				if cb then cb(value) end
			end
			set(value)
			local drag = false
			local function upd(x)
				local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
				set(min + (max - min) * a)
			end
			bar.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					drag = true
					upd(i.Position.X)
				end
			end)
			UIS.InputChanged:Connect(function(i)
				if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
					upd(i.Position.X)
				end
			end)
			UIS.InputEnded:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					drag = false
				end
			end)
		end

		return Tab
	end

	return Window
end

return Lib
